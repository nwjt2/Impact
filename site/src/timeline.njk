<script src="{{ '/assets/js/render.js' | url }}"></script>
<script>
(function () {
  "use strict";
  var I = window.IFC;

  // Sector vocabulary — covers both naming conventions used across content
  // YAMLs (peer_funds uses `gender`; /match/ uses `gender_lens`). Only chips
  // for tags that actually appear in the population are rendered.
  var SECTOR_LABELS = {
    fi: "Financial inclusion", agri: "Agriculture", smb: "SMEs / livelihoods",
    climate: "Climate", energy: "Energy", health: "Health", edu: "Education",
    wash: "Water & sanitation", gender: "Gender lens", gender_lens: "Gender lens",
    housing: "Housing", forestry: "Forestry / nature", biodiversity: "Biodiversity",
    humanitarian: "Humanitarian", generalist: "Generalist",
  };
  var SECTOR_ORDER = ["fi","agri","smb","climate","energy","health","edu","wash","gender","gender_lens","housing","forestry","biodiversity","humanitarian","generalist"];

  var GEO_LABELS = {
    africa: "Africa", mena: "MENA", asia: "Asia", latam: "Latin America",
    us: "United States", europe: "Europe", global: "Global",
  };
  var GEO_ORDER = ["africa","mena","asia","latam","us","europe","global"];

  var COHORT_LABELS = { ingo_only: "INGO-sponsored only", include_comparables: "Include comparables" };
  var COHORT_ORDER = ["ingo_only", "include_comparables"];

  // ---- Load + filter to funds with first_close_date -----------------------
  var PEER = I.loadJSON("data-peer-funds") || [];
  var BUILD = I.loadJSON("data-meta") || {};
  var TODAY = (BUILD.last_run_timestamp || BUILD.generated_at || new Date().toISOString()).slice(0, 10);

  function parseDate(iso) { return iso ? Date.parse(iso) : null; }
  function monthsBetween(a, b) {
    var ms = parseDate(b) - parseDate(a);
    return ms / (1000 * 60 * 60 * 24 * 30.4375);
  }
  function fmtMonths(m) {
    if (m == null || isNaN(m)) return "—";
    if (m < 1) return "<1mo";
    if (m < 24) return Math.round(m) + "mo";
    return (m / 12).toFixed(1) + "yr";
  }

  // Population: every peer fund with a first_close_date.
  var POP = PEER.filter(function (f) { return f.first_close_date; });

  // ---- Picker state -------------------------------------------------------
  var state = {
    sectors: new Set(),
    geos: new Set(),
    cohort: new Set(["include_comparables"]), // default: include comparables
    youAnnounce: null,
  };

  function buildChips(host, dim, order, labels) {
    host.innerHTML = order.map(function (k) {
      var on = state[dim].has(k) ? " is-on" : "";
      return '<button type="button" class="picker-chip' + on + '" data-key="' + I.escAttr(k) + '">'
        + I.esc(labels[k] || k) + '</button>';
    }).join("");
    host.addEventListener("click", function (evt) {
      var btn = evt.target.closest(".picker-chip");
      if (!btn) return;
      var key = btn.getAttribute("data-key");
      var s = state[dim];
      if (dim === "cohort") {
        // cohort is single-select (toggle which mode)
        s.clear(); s.add(key);
        host.querySelectorAll(".picker-chip").forEach(function (b) { b.classList.remove("is-on"); });
        btn.classList.add("is-on");
      } else {
        if (s.has(key)) { s.delete(key); btn.classList.remove("is-on"); }
        else { s.add(key); btn.classList.add("is-on"); }
      }
      render();
    });
  }

  // Build the live tag inventory from the population so the picker only
  // shows chips that actually filter to non-empty results.
  var sectorsInUse = new Set();
  var geosInUse = new Set();
  PEER.filter(function (f) { return f.first_close_date; }).forEach(function (f) {
    (f.sector_tags || []).forEach(function (t) { sectorsInUse.add(t); });
    (f.geo_tags || []).forEach(function (t) { geosInUse.add(t); });
  });

  var sectorOrder = SECTOR_ORDER.filter(function (k) { return sectorsInUse.has(k); });
  var geoOrder = GEO_ORDER.filter(function (k) { return geosInUse.has(k); });

  document.querySelectorAll("#tl-picker .picker-chips").forEach(function (host) {
    var dim = host.getAttribute("data-dim");
    if (dim === "sectors") buildChips(host, "sectors", sectorOrder, SECTOR_LABELS);
    else if (dim === "geos") buildChips(host, "geos", geoOrder, GEO_LABELS);
    else if (dim === "cohort") buildChips(host, "cohort", COHORT_ORDER, COHORT_LABELS);
  });

  document.getElementById("tl-reset").addEventListener("click", function () {
    state.sectors.clear(); state.geos.clear();
    state.cohort.clear(); state.cohort.add("include_comparables");
    document.querySelectorAll("#tl-picker .picker-chip").forEach(function (b) { b.classList.remove("is-on"); });
    document.querySelector('#tl-picker [data-dim="cohort"] [data-key="include_comparables"]').classList.add("is-on");
    render();
  });

  var youInput = document.getElementById("tl-announce");
  youInput.addEventListener("input", function () {
    state.youAnnounce = youInput.value || null;
    render();
  });
  document.getElementById("tl-clear-you").addEventListener("click", function () {
    youInput.value = "";
    state.youAnnounce = null;
    render();
  });

  // ---- Filter ------------------------------------------------------------
  function passes(f) {
    if (state.cohort.has("ingo_only") && !f.parent_ingo) return false;
    if (state.sectors.size > 0) {
      var any = (f.sector_tags || []).some(function (t) { return state.sectors.has(t); });
      if (!any) return false;
    }
    if (state.geos.size > 0) {
      var any2 = (f.geo_tags || []).some(function (t) { return state.geos.has(t); });
      if (!any2) return false;
    }
    return true;
  }

  // ---- Distribution stats -------------------------------------------------
  function median(arr) {
    if (!arr.length) return null;
    var s = arr.slice().sort(function (a, b) { return a - b; });
    var mid = Math.floor(s.length / 2);
    return s.length % 2 === 0 ? (s[mid - 1] + s[mid]) / 2 : s[mid];
  }
  function range(arr) {
    if (!arr.length) return null;
    return { min: Math.min.apply(null, arr), max: Math.max.apply(null, arr) };
  }

  // ---- Headlines ----------------------------------------------------------
  //
  // Honest framing for the "announce to first close" metric:
  //   - Funds where announce_date == first_close_date are effectively
  //     publicizing a pre-arranged close, not running a public fundraise.
  //     They are NOT a useful benchmark for an INGO mid-raise.
  //   - Split the metric: "funds with a public raising window" (gap ≥ 30 days)
  //     drives the headline; "same-day announce/close" funds counted separately.
  //   - When the raising-window sample is < 3, surface raw data points instead
  //     of a median — n=2 doesn't meaningfully median.
  function renderHeadlines(working) {
    var withAnnounce = working.filter(function (f) { return f.announce_date && f.first_close_date; });
    var withFinal = working.filter(function (f) {
      return f.first_close_date && f.final_close_date
        && f.first_close_date !== f.final_close_date;
    });

    var aMonthsAll = withAnnounce.map(function (f) { return monthsBetween(f.announce_date, f.first_close_date); });
    var raising = aMonthsAll.filter(function (m) { return m >= 1; });   // ≥ 1 month = "real" raise window
    var sameDay = aMonthsAll.length - raising.length;

    var fMonths = withFinal.map(function (f) { return monthsBetween(f.first_close_date, f.final_close_date); });

    var aMed = median(raising), aRng = range(raising);
    var fMed = median(fMonths), fRng = range(fMonths);

    // Card 1: announce → first close, raising-window only
    function announceCard(youTail) {
      var medCell, tail;
      if (raising.length === 0) {
        medCell = '<div class="tl-headline-num is-empty">—</div>';
        tail = "no peer funds in the working set disclose a public raising window"
          + (sameDay > 0 ? " · " + sameDay + " disclosed announce date == first close (pre-arranged close, not a fundraise window)" : "");
      } else if (raising.length < 3) {
        // Show raw data points, not a median.
        var pts = raising.map(function (m) { return fmtMonths(m); }).join(", ");
        medCell = '<div class="tl-headline-num">n=' + raising.length + '</div>';
        tail = "data points: <strong>" + pts + "</strong> · too few to median"
          + (sameDay > 0 ? " · " + sameDay + " same-day announce/close (excluded)" : "");
      } else {
        medCell = '<div class="tl-headline-num">' + fmtMonths(aMed).replace(/(\d+)([a-z]+)/, '$1<span class="tl-headline-unit">$2</span>') + '</div>';
        tail = "median across <strong>" + raising.length + "</strong> peer funds with a disclosed raising window · range "
          + fmtMonths(aRng.min) + "–" + fmtMonths(aRng.max)
          + (sameDay > 0 ? "<br><span class=\"muted\">+ " + sameDay + " same-day announce/close (excluded — no public raising window)</span>" : "");
      }
      if (youTail) tail += "<br>" + youTail;
      return '<div class="tl-headline">'
        + '<div class="tl-headline-label">Time on market before first close</div>'
        + medCell
        + '<div class="tl-headline-tail">' + tail + '</div>'
        + '</div>';
    }

    function finalCard() {
      var medCell, tail;
      if (withFinal.length === 0) {
        medCell = '<div class="tl-headline-num is-empty">—</div>';
        tail = "no peer funds in the working set disclose a final-close date distinct from first close";
      } else if (withFinal.length < 3) {
        var pts = fMonths.map(function (m) { return fmtMonths(m); }).join(", ");
        medCell = '<div class="tl-headline-num">n=' + withFinal.length + '</div>';
        tail = "data points: <strong>" + pts + "</strong> · too few to median";
      } else {
        medCell = '<div class="tl-headline-num">' + fmtMonths(fMed).replace(/(\d+)([a-z]+)/, '$1<span class="tl-headline-unit">$2</span>') + '</div>';
        tail = "median across <strong>" + withFinal.length + "</strong> of " + working.length + " filtered funds · range "
          + fmtMonths(fRng.min) + "–" + fmtMonths(fRng.max);
      }
      return '<div class="tl-headline">'
        + '<div class="tl-headline-label">First close → final close</div>'
        + medCell
        + '<div class="tl-headline-tail">' + tail + '</div>'
        + '</div>';
    }

    // "You are here" tail for the announce-to-first card
    var youTail = "";
    if (state.youAnnounce) {
      var elapsed = monthsBetween(state.youAnnounce, TODAY);
      if (elapsed >= 0) {
        var compare = "";
        if (raising.length >= 3) {
          var delta = elapsed - aMed;
          if (Math.abs(delta) < 1) compare = "right at the median";
          else if (delta > 0) compare = '<strong>' + fmtMonths(delta) + ' past</strong> median';
          else compare = fmtMonths(-delta) + ' below median';
        }
        youTail = "Your fund: <strong>" + fmtMonths(elapsed) + "</strong> since announce" + (compare ? " · " + compare : "");
      }
    }

    document.getElementById("tl-headlines").innerHTML = announceCard(youTail) + finalCard();

    // Stash the median for the chart to read.
    return { aMed: raising.length >= 3 ? aMed : null };
  }

  // ---- Small-multiples chart ----------------------------------------------
  // Each row = one fund. X-axis = months from a reference point.
  //
  // Reference point per row:
  //   - If announce_date present: that's t=0
  //   - Else: first_close_date is t=0 (a single point), with no pre-bar
  //
  // Extend rightward to final_close_date if known.

  function renderChart(working, opts) {
    opts = opts || {};
    var host = document.getElementById("tl-chart");
    if (working.length === 0) {
      host.innerHTML = '<div class="tl-empty">No peer funds match the current filter.</div>';
      return;
    }

    // Sort: most-recent first close at top.
    var rows = working.slice().sort(function (a, b) {
      return (b.first_close_date || "").localeCompare(a.first_close_date || "");
    });

    // X-axis range: 0 .. max(months across all rows from announce/first to final/today).
    var maxMonths = 1;
    rows.forEach(function (f) {
      var t0 = f.announce_date || f.first_close_date;
      var t1 = f.final_close_date || f.first_close_date;
      var m = monthsBetween(t0, t1);
      if (m > maxMonths) maxMonths = m;
      if (f.announce_date) {
        var m2 = monthsBetween(f.announce_date, f.first_close_date);
        if (m2 > maxMonths) maxMonths = m2;
      }
    });
    // Also include "you are here" elapsed if set, so the marker is visible.
    if (state.youAnnounce) {
      var youElapsed = monthsBetween(state.youAnnounce, TODAY);
      if (youElapsed > maxMonths) maxMonths = youElapsed;
    }
    maxMonths = Math.ceil(maxMonths + 1);

    // Geometry
    var ROW_H = 30, ROW_GAP = 6;
    var LABEL_W = 420, BAR_AREA = 540, RIGHT_PAD = 240, PADDING = 14;
    var width = LABEL_W + BAR_AREA + RIGHT_PAD + PADDING * 2;
    // TOP is the y of the first row. Above it: 36px reserved for the
    // median callout band, then 14px for axis ticks (axisY = TOP - 14).
    var TOP = 56;
    var height = TOP + rows.length * (ROW_H + ROW_GAP) + 16;

    var x0 = PADDING + LABEL_W;

    function xFor(months) { return x0 + (months / maxMonths) * BAR_AREA; }

    var parts = [];
    parts.push('<svg class="tl-chart" viewBox="0 0 ' + width + ' ' + height
      + '" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Peer fund first-close timelines">');

    // X-axis ticks (every 6 months up to maxMonths, capped at ~12 ticks).
    var step = maxMonths <= 12 ? 3 : maxMonths <= 36 ? 6 : 12;
    var axisY = TOP - 14;
    parts.push('<line class="tl-axis-line" x1="' + x0 + '" x2="' + (x0 + BAR_AREA)
      + '" y1="' + axisY + '" y2="' + axisY + '" />');
    for (var t = 0; t <= maxMonths; t += step) {
      var tx = xFor(t);
      parts.push('<line class="tl-axis-line" x1="' + tx + '" x2="' + tx
        + '" y1="' + axisY + '" y2="' + (axisY + 4) + '" />');
      var lbl = t === 0 ? "0" : (t < 24 ? t + "mo" : (t / 12) + "yr");
      parts.push('<text class="tl-axis-tick" x="' + tx + '" y="' + (axisY - 4)
        + '" text-anchor="middle">' + I.esc(lbl) + '</text>');
    }

    // Median announce→first marker (red dashed) — uses the raising-window
    // median computed by renderHeadlines (zero-day same-day announces excluded).
    // Label sits at the TOP of the line so it doesn't collide with the
    // footer legend.
    var aMed = opts.aMed;
    if (aMed != null && aMed > 0) {
      var medX = xFor(aMed);
      parts.push('<line class="tl-median" x1="' + medX + '" x2="' + medX
        + '" y1="' + (TOP - 4) + '" y2="' + (height - 24) + '" />');
      // Sits in the dedicated callout band, ~16px above the axis ticks.
      parts.push('<text class="tl-median-label" x="' + medX + '" y="' + (TOP - 36)
        + '" text-anchor="middle">median ' + I.esc(fmtMonths(aMed)) + '</text>');
    }

    // "You are here" vertical line — label sits in the same callout band
    // as the median, but offset by 14px so the two never collide.
    if (state.youAnnounce) {
      var youElapsed = monthsBetween(state.youAnnounce, TODAY);
      if (youElapsed >= 0 && youElapsed <= maxMonths) {
        var yx = xFor(youElapsed);
        parts.push('<line class="tl-you" x1="' + yx + '" x2="' + yx
          + '" y1="' + (TOP - 4) + '" y2="' + (height - 24) + '" />');
        parts.push('<text class="tl-you-label" x="' + yx + '" y="' + (TOP - 50)
          + '" text-anchor="middle">you · ' + I.esc(fmtMonths(youElapsed)) + '</text>');
      }
    }

    // Rows
    rows.forEach(function (f, i) {
      var y = TOP + i * (ROW_H + ROW_GAP);
      var yMid = y + ROW_H / 2 + 4;

      // Label — proportional sans, capped to fit LABEL_W (420 viewBox px ≈
      // ~46 chars at 0.82rem sans bold). SVG <title> gives a hover tooltip
      // with the full name when truncation does kick in.
      var fullName = f.name;
      var label = fullName.length > 46 ? fullName.slice(0, 44) + "…" : fullName;
      parts.push('<g class="tl-row">');
      parts.push('<title>' + I.esc(fullName) + '</title>');
      parts.push('<text class="tl-row-label" x="' + (PADDING + LABEL_W - 10)
        + '" y="' + (y + 12) + '" text-anchor="end">' + I.esc(label) + '</text>');

      var metaBits = [];
      if (f.parent_ingo) {
        var pi = f.parent_ingo.length > 32 ? f.parent_ingo.slice(0, 30) + "…" : f.parent_ingo;
        metaBits.push(pi);
      }
      if (f.first_close_date) metaBits.push(String(f.first_close_date).slice(0, 7));
      if (f.size_usd_m != null) metaBits.push("$" + f.size_usd_m + "M");
      var metaTxt = metaBits.join(" · ");
      if (metaTxt.length > 56) metaTxt = metaTxt.slice(0, 54) + "…";
      parts.push('<text class="tl-row-meta" x="' + (PADDING + LABEL_W - 10)
        + '" y="' + (y + 25) + '" text-anchor="end">' + I.esc(metaTxt) + '</text>');

      // Bars
      var barY = y + 7;
      var barH = 14;

      // Classify the row to decide rendering:
      //   sameDay      — announce_date present AND ≈ first_close (< 1 month gap)
      //   raising      — announce_date present AND ≥ 1 month before first close
      //   pointOnly    — no announce_date, just first close
      var aMonthsThis = f.announce_date ? monthsBetween(f.announce_date, f.first_close_date) : null;
      var sameDay = aMonthsThis != null && aMonthsThis < 1;
      var raising = aMonthsThis != null && aMonthsThis >= 1;
      var fcX = xFor(raising ? aMonthsThis : 0);

      // Render order: bars first (background), then markers on top so the
      // same-day diamond / no-announce dot is never buried by a final-close
      // amber bar that starts at the same x.

      // Pre-first-close raising-window bar (only when raising)
      if (raising) {
        var preCls = "tl-bar-pre" + (f.announce_date_month_only ? " tl-month-only" : "");
        parts.push('<rect class="' + preCls + '" x="' + xFor(0) + '" y="' + barY
          + '" width="' + (fcX - xFor(0)) + '" height="' + barH + '" rx="2" />');
      }

      // Post-first → final close (extends rightward from first close)
      var hasFinal = f.final_close_date && f.final_close_date !== f.first_close_date;
      if (hasFinal) {
        var startM = raising ? aMonthsThis : 0;
        var totalM = startM + monthsBetween(f.first_close_date, f.final_close_date);
        var postX = fcX, postW = Math.max(2, xFor(totalM) - postX);
        parts.push('<rect class="tl-bar-post" x="' + postX + '" y="' + barY
          + '" width="' + postW + '" height="' + barH + '" rx="2" />');

        var fStr = String(f.final_close_date).slice(0, 7);
        parts.push('<text class="tl-row-final" x="' + (postX + postW + 6)
          + '" y="' + (barY + barH - 2) + '">final ' + I.esc(fStr) + '</text>');
      }

      // First-close tick (between bar layers and marker layer so the marker
      // overrides if same-day diamond sits on the tick)
      parts.push('<line class="tl-axis-line" x1="' + fcX + '" x2="' + fcX
        + '" y1="' + barY + '" y2="' + (barY + barH) + '" stroke-width="1.5" />');

      // Marker on top — same-day diamond or no-announce dot. Stroke so the
      // marker reads cleanly on top of the amber bar when the row also has
      // a first→final-close span.
      if (sameDay) {
        var cx = xFor(0), cy = barY + barH / 2;
        parts.push('<polygon class="tl-bar-sameday" points="'
          + (cx - 6) + ',' + cy + ' '
          + cx + ',' + (cy - 6) + ' '
          + (cx + 6) + ',' + cy + ' '
          + cx + ',' + (cy + 6) + '" />');
      } else if (!raising) {
        parts.push('<circle class="tl-bar-point" cx="' + xFor(0)
          + '" cy="' + (barY + barH / 2) + '" r="4.5" />');
      }

      // Right-side annotation: anchor LP and/or status tag that explains
      // the marker. Same-day and "no announce" tags are additive when an
      // anchor is also known — both apply.
      var rightX = hasFinal ? null : (fcX + 8);
      if (rightX != null) {
        var anchorPart = "";
        if (f.anchor_lp) {
          var anchor = f.anchor_lp.length > 36 ? f.anchor_lp.slice(0, 34) + "…" : f.anchor_lp;
          anchorPart = '⚓ ' + I.esc(anchor);
        }
        var statusPart = "";
        if (sameDay) statusPart = "same-day announce/close";
        else if (!f.announce_date) statusPart = "first close only · no announce date on file";

        if (anchorPart && statusPart) {
          parts.push('<text class="tl-row-anchor" x="' + rightX
            + '" y="' + (barY + barH - 2) + '">' + anchorPart
            + ' <tspan class="tl-row-sameday-inline">· ' + statusPart + '</tspan></text>');
        } else if (anchorPart) {
          parts.push('<text class="tl-row-anchor" x="' + rightX
            + '" y="' + (barY + barH - 2) + '">' + anchorPart + '</text>');
        } else if (statusPart) {
          parts.push('<text class="tl-row-sameday" x="' + rightX
            + '" y="' + (barY + barH - 2) + '">' + statusPart + '</text>');
        }
      }

      parts.push('</g>');
    });

    // Legend lives outside the SVG (above the chart) for accessibility +
    // styling. See the .tl-legend block in the template.

    parts.push('</svg>');
    host.innerHTML = parts.join("");
  }

  // ---- Top-level render ---------------------------------------------------
  function render() {
    var working = POP.filter(passes);

    // Picker summary
    var youStatus = "";
    if (state.youAnnounce) {
      var el = monthsBetween(state.youAnnounce, TODAY);
      youStatus = (el >= 0) ? fmtMonths(el) + " elapsed" : "future date";
    }
    document.getElementById("tl-you-status").textContent = youStatus;

    var summaryEl = document.getElementById("tl-summary");
    summaryEl.innerHTML = "Working sample: <strong>" + working.length + "</strong> of "
      + POP.length + " peer funds with disclosed first-close date";

    var opts = renderHeadlines(working) || {};
    renderChart(working, opts);
  }

  render();
})();
</script>
