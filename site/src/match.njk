---
layout: base.njk
title: Match my fund
permalink: /match-my-fund/index.html
pageKey: match
---

<section class="detail-page">
  <p class="back-link"><a href="{{ '/' | url }}">← Back to index</a></p>
  <header class="detail-header">
    <div class="detail-eyebrow">
      <span>Decision support · LP shortlist for an INGO-sponsored fund</span>
    </div>
    <h1>Match my fund.</h1>
    <p class="detail-sub">Filter the {{ slot_meta.slot_counts.foundation_lps + slot_meta.slot_counts.family_office_lps + slot_meta.slot_counts.dfi_ingo_commits + slot_meta.slot_counts.bank_lps + slot_meta.slot_counts.asset_manager_lps + slot_meta.slot_counts.pension_fund_lps + slot_meta.slot_counts.corporate_lps + slot_meta.slot_counts.government_donor_lps + slot_meta.slot_counts.cooperative_ngo_lps }} LPs in the network by your fund's themes, geography, and the archetypes you'd consider. Strict <strong>AND</strong> — every selected filter must appear in the LP's stated thesis.</p>
  </header>

  <form id="picker" class="picker">
    <fieldset class="picker-group">
      <legend class="picker-legend">Impact themes <span class="picker-hint">— pick the themes your fund will pursue</span></legend>
      <div class="picker-chips" data-dim="themes"></div>
    </fieldset>

    <fieldset class="picker-group">
      <legend class="picker-legend">Geography <span class="picker-hint">— pick where your fund will deploy</span></legend>
      <div class="picker-chips" data-dim="geos"></div>
    </fieldset>

    <fieldset class="picker-group">
      <legend class="picker-legend">LP archetypes you'd consider <span class="picker-hint">— pick none to consider all</span></legend>
      <div class="picker-chips" data-dim="archetypes"></div>
    </fieldset>

    <div class="picker-actions">
      <button type="button" id="picker-reset" class="picker-reset">Reset all</button>
      <span id="picker-summary" class="picker-summary"></span>
    </div>
  </form>

  <div id="match-list" class="match-list" aria-live="polite"></div>
</section>

<script type="application/json" id="data-foundations">{{ foundation_lps | dump | safe }}</script>
<script type="application/json" id="data-family-offices">{{ family_office_lps | dump | safe }}</script>
<script type="application/json" id="data-dfis">{{ dfi_ingo_commits | dump | safe }}</script>
<script type="application/json" id="data-banks">{{ bank_lps | dump | safe }}</script>
<script type="application/json" id="data-asset-managers">{{ asset_manager_lps | dump | safe }}</script>
<script type="application/json" id="data-pension-funds">{{ pension_fund_lps | dump | safe }}</script>
<script type="application/json" id="data-corporates">{{ corporate_lps | dump | safe }}</script>
<script type="application/json" id="data-government-donors">{{ government_donor_lps | dump | safe }}</script>
<script type="application/json" id="data-cooperative-ngos">{{ cooperative_ngo_lps | dump | safe }}</script>
<script type="application/json" id="data-network">{{ network | dump | safe }}</script>
<script type="application/json" id="data-net-lp-funds">{{ network_lp_summary.lpFundsBySlug | dump | safe }}</script>
<script type="application/json" id="data-lp-990-signals">{{ network_lp_990_signals | dump | safe }}</script>
<script type="application/json" id="data-slot-meta">{{ slot_meta | dump | safe }}</script>

<script src="{{ '/assets/js/render.js' | url }}"></script>
<script>
(function () {
  "use strict";
  var I = window.IFC;

  // ---- Taxonomies ----------------------------------------------------------

  var THEME_LABELS = {
    climate: "Climate", agri: "Agriculture", energy: "Energy", health: "Health",
    fi: "Financial inclusion", smb: "SMEs / livelihoods", edu: "Education",
    housing: "Affordable housing", wash: "Water & sanitation",
    gender_lens: "Gender lens", forestry: "Forestry / nature",
    generalist: "Generalist (broad mandate)",
  };
  var THEME_ORDER = ["climate","agri","energy","health","fi","smb","edu","housing","wash","gender_lens","forestry","generalist"];

  var GEO_LABELS = {
    africa: "Africa", mena: "MENA", asia: "Asia", latam: "Latin America",
    us: "United States", europe: "Europe", global: "Global",
  };
  var GEO_ORDER = ["africa","mena","asia","latam","us","europe","global"];

  var ARCH_LABELS = {
    dfi: "DFI", foundation: "Foundation", "family-office": "Family office",
    "asset-manager": "Asset manager / MIV", bank: "Bank",
    "pension-fund": "Pension fund", corporate: "Corporate",
    "bilateral-donor": "Bilateral donor", government: "Sovereign government",
    "cooperative-ngo": "NGO / cooperative", vc: "VC / private fund",
  };
  var ARCH_ORDER = ["dfi","foundation","family-office","asset-manager","bank","pension-fund","corporate","bilateral-donor","government","cooperative-ngo","vc"];

  // ---- Helpers --------------------------------------------------------------

  // Compact USD for the 990 sizing line. $76.9B / $607M / $35M / $25K.
  // Returns "" for null/zero/non-finite — caller can null-check.
  function fmtUSDShort(n) {
    if (n == null || !isFinite(n) || n <= 0) return "";
    if (n >= 1e9) {
      var b = n / 1e9;
      return "$" + (b >= 10 ? Math.round(b) : b.toFixed(1)) + "B";
    }
    if (n >= 1e6) return "$" + Math.round(n / 1e6) + "M";
    if (n >= 1e3) return "$" + Math.round(n / 1e3) + "K";
    return "$" + Math.round(n);
  }

  // ---- Load + normalise the LP corpus --------------------------------------

  var network = I.loadJSON("data-network") || { nodes: [], edges: [] };
  var META = I.loadJSON("data-slot-meta") || {};
  var NET_LP = I.loadJSON("data-net-lp-funds") || {};
  // ProPublica 990 sizing data — keyed by LP slug, only US foundations populated.
  // Honest-null: if absent or missing fields, the render path skips the line.
  var LP_990 = I.loadJSON("data-lp-990-signals") || {};

  // Map network investor slug → archetype
  var archBySlug = {};
  network.nodes.forEach(function (n) {
    if (n.type === "investor") {
      archBySlug[n.id.slice(9)] = n.investor_type || "other";
    }
  });

  // Build fund→LPs from NET_LP (which is LP→funds). Used to compute
  // "who can introduce you to LP X" — co-LPs of X across any fund X is
  // an LP in. Each introducer carries the shared fund as evidence.
  var FUND_TO_LPS = {};
  Object.keys(NET_LP).forEach(function (lpSlug) {
    (NET_LP[lpSlug] || []).forEach(function (f) {
      if (!FUND_TO_LPS[f.fund_slug]) {
        FUND_TO_LPS[f.fund_slug] = { name: f.fund_name, lps: [] };
      }
      FUND_TO_LPS[f.fund_slug].lps.push({ slug: lpSlug, source_url: f.source_url });
    });
  });

  function pull(elemId, themesField, geoField, categoryField, registryArchetype) {
    return (I.loadJSON(elemId) || []).map(function (d) {
      return {
        slug: d.slug || d.dfi_slug,
        name: d.name || d.dfi_name,
        country: d.country || d.dfi_country || "",
        category: categoryField ? d[categoryField] : null,
        themes: d[themesField] || [],
        geos: d[geoField] || [],
        thesis_url: d.stated_thesis_url || null,
        thesis_excerpt: d.stated_thesis_excerpt || null,
        registryArchetype: registryArchetype,
      };
    });
  }

  var lps = []
    .concat(pull("data-foundations",        "stated_priority_themes",     "stated_geo_focus",     "foundation_type", "foundation"))
    .concat(pull("data-family-offices",     "stated_priority_themes",     "stated_geo_focus",     "category",        "family-office"))
    .concat(pull("data-dfis",               "stated_sector_priorities",   "stated_geo_priorities", null,             "dfi"))
    .concat(pull("data-banks",              "stated_priority_themes",     "stated_geo_focus",     "category",        "bank"))
    .concat(pull("data-asset-managers",     "stated_priority_themes",     "stated_geo_focus",     "category",        "asset-manager"))
    .concat(pull("data-pension-funds",      "stated_priority_themes",     "stated_geo_focus",     "category",        "pension-fund"))
    .concat(pull("data-corporates",         "stated_priority_themes",     "stated_geo_focus",     "category",        "corporate"))
    .concat(pull("data-government-donors",  "stated_priority_themes",     "stated_geo_focus",     "category",        "bilateral-donor"))
    .concat(pull("data-cooperative-ngos",   "stated_priority_themes",     "stated_geo_focus",     "category",        "cooperative-ngo"));

  // Corpus = every LP in the registries ∪ every LP that appears in the
  // network as an edge. A slug can appear in multiple registries
  // (ImpactAssets is intentionally in both family_office_lps.yml and
  // asset_manager_lps.yml), so dedupe by slug. Registry-only entries
  // (no observed edge yet) carry the honest "0 tracked LP commits"
  // footer; tier-A/tier-B sort still floats well-documented LPs to the top.
  var lpsBySlug = {};
  lps.forEach(function (lp) {
    if (!lpsBySlug[lp.slug]) lpsBySlug[lp.slug] = lp;
  });
  Object.keys(NET_LP).forEach(function (slug) {
    if (!lpsBySlug[slug]) {
      lpsBySlug[slug] = { slug: slug, name: slug, country: "", category: null, themes: [], geos: [], thesis_url: null, thesis_excerpt: null };
    }
  });
  var corpus = Object.keys(lpsBySlug).map(function (slug) {
    var lp = lpsBySlug[slug];
    // Prefer the network's observed archetype (e.g. "vc" for an investor we
    // discovered through edges); fall back to the registry archetype for
    // entries with no edges yet (JIMCO, Olayan, etc).
    lp.archetype = archBySlug[slug] || lp.registryArchetype || "other";
    lp.networkLpCount = (NET_LP[slug] || []).length;
    lp.networkLpFunds = NET_LP[slug] || [];
    lp.hasThesis = (lp.themes && lp.themes.length > 0) || (lp.geos && lp.geos.length > 0);
    return lp;
  });

  // Slug → corpus entry, for fast name/archetype lookup when rendering
  // introducer rows on each card.
  var corpusBySlug = {};
  corpus.forEach(function (lp) { corpusBySlug[lp.slug] = lp; });

  // For LP X, return every other LP that has co-LP'd with X in any fund X
  // is in (deduped, alphabetical). Each entry cites the shared fund as
  // primary-source evidence of the warm-intro path.
  function introducersFor(slug) {
    var seen = {};
    (NET_LP[slug] || []).forEach(function (cf) {
      var fundData = FUND_TO_LPS[cf.fund_slug];
      if (!fundData) return;
      fundData.lps.forEach(function (other) {
        if (other.slug === slug) return;
        if (seen[other.slug]) return;
        var meta = corpusBySlug[other.slug] || {};
        seen[other.slug] = {
          slug: other.slug,
          name: meta.name || other.slug,
          archetype: meta.archetype || "other",
          via_fund_slug: cf.fund_slug,
          via_fund_name: cf.fund_name,
          source_url: cf.source_url || other.source_url || null,
        };
      });
    });
    return Object.values(seen).sort(function (a, b) {
      return (a.name || "").toLowerCase().localeCompare((b.name || "").toLowerCase());
    });
  }

  // ---- Picker state --------------------------------------------------------

  var state = { themes: new Set(), geos: new Set(), archetypes: new Set() };

  function buildChips(host, dim, order, labels) {
    host.innerHTML = order.map(function (k) {
      return '<button type="button" class="picker-chip" data-key="' + I.escAttr(k) + '">' + I.esc(labels[k]) + '</button>';
    }).join("");
    host.addEventListener("click", function (evt) {
      var btn = evt.target.closest(".picker-chip");
      if (!btn) return;
      var key = btn.getAttribute("data-key");
      var set = state[dim];
      if (set.has(key)) { set.delete(key); btn.classList.remove("is-on"); }
      else { set.add(key); btn.classList.add("is-on"); }
      render();
    });
  }

  document.querySelectorAll(".picker-chips").forEach(function (host) {
    var dim = host.getAttribute("data-dim");
    if (dim === "themes") buildChips(host, "themes", THEME_ORDER, THEME_LABELS);
    else if (dim === "geos") buildChips(host, "geos", GEO_ORDER, GEO_LABELS);
    else if (dim === "archetypes") buildChips(host, "archetypes", ARCH_ORDER, ARCH_LABELS);
  });

  document.getElementById("picker-reset").addEventListener("click", function () {
    state.themes.clear(); state.geos.clear(); state.archetypes.clear();
    document.querySelectorAll(".picker-chip.is-on").forEach(function (b) { b.classList.remove("is-on"); });
    render();
  });

  // ---- Filtering + scoring -------------------------------------------------
  //
  // AND across dimensions: an LP must satisfy every dimension the user has
  // selected on. Within a dimension, OR — at least one selected value must
  // appear in the LP's stated thesis. Strict: generalist theme and global
  // geo do NOT pass as proxies — if the user picked Energy, the LP needs
  // to actually list Energy.

  function passesFilter(lp) {
    if (state.archetypes.size > 0 && !state.archetypes.has(lp.archetype)) return false;

    if (state.themes.size > 0) {
      var lpThemes = new Set(lp.themes || []);
      var anyHit = false;
      state.themes.forEach(function (t) { if (lpThemes.has(t)) anyHit = true; });
      if (!anyHit) return false;
    }

    if (state.geos.size > 0) {
      var lpGeos = new Set(lp.geos || []);
      var anyHit = false;
      state.geos.forEach(function (g) { if (lpGeos.has(g)) anyHit = true; });
      if (!anyHit) return false;
    }

    return true;
  }

  function score(lp) {
    var themes = state.themes, geos = state.geos, archs = state.archetypes;
    var matched = { themes: [], geos: [], archetype: false };
    var s = 0;

    if (themes.size > 0) {
      var lpThemes = new Set(lp.themes || []);
      var hits = 0;
      themes.forEach(function (t) {
        if (lpThemes.has(t)) { hits++; matched.themes.push(t); }
      });
      // Generalist = half-credit for any unmatched user pick (broad mandate).
      var generalistBoost = (lpThemes.has("generalist") && hits === 0) ? 0.5 : 0;
      s += (hits / themes.size) + generalistBoost;
    }

    if (geos.size > 0) {
      var lpGeos = new Set(lp.geos || []);
      var anyHit = false;
      geos.forEach(function (g) {
        if (lpGeos.has(g)) { anyHit = true; matched.geos.push(g); }
      });
      // Global LP = half-credit for any user pick.
      if (!anyHit && lpGeos.has("global")) {
        s += 0.5;
        matched.geos.push("global");
      } else if (anyHit) {
        s += 1;
      }
    }

    if (archs.size > 0) {
      if (archs.has(lp.archetype)) {
        s += 1;
        matched.archetype = true;
      }
    }

    return { score: s, matched: matched };
  }

  // ---- Render --------------------------------------------------------------

  function render() {
    var anySelected = state.themes.size + state.geos.size + state.archetypes.size > 0;

    var ranked = corpus
      .filter(passesFilter)
      .map(function (lp) {
        var r = score(lp);
        return Object.assign({}, lp, { _score: r.score, _matched: r.matched });
      });

    ranked.sort(function (a, b) {
      // Tier A first (has thesis data), tier B second (no thesis data).
      if (a.hasThesis !== b.hasThesis) return a.hasThesis ? -1 : 1;
      if (a._score !== b._score) return b._score - a._score;
      if (a.networkLpCount !== b.networkLpCount) return b.networkLpCount - a.networkLpCount;
      return (a.name || "").localeCompare(b.name || "");
    });

    var summary = document.getElementById("picker-summary");
    if (anySelected) {
      if (ranked.length === 0) {
        summary.innerHTML = "<strong>No LPs match all of your filters.</strong> Try removing a constraint, or check whether the combination is realistic.";
      } else {
        summary.innerHTML = "Showing <strong>" + ranked.length + "</strong> LP" + (ranked.length === 1 ? "" : "s") + " matching all selected filters, ranked by overlap strength";
      }
    } else {
      summary.innerHTML = "Showing all <strong>" + ranked.length + "</strong> LPs in network — pick filters above to narrow the set";
    }

    var listHost = document.getElementById("match-list");
    listHost.innerHTML = ranked.map(function (lp) { return renderCard(lp, anySelected); }).join("");
  }

  function renderCard(lp, anySelected) {
    var matched = lp._matched || { themes: [], geos: [], archetype: false };
    var matchedThemes = new Set(matched.themes);
    var matchedGeos = new Set(matched.geos);

    var detailHref = detailUrl(lp);
    var name = detailHref
      ? '<a href="' + I.escAttr(detailHref) + '" class="match-name-link">' + I.esc(lp.name) + '</a>'
      : I.esc(lp.name);

    var bits = [];
    bits.push('<div class="match-head">');
    bits.push('<h3 class="match-name">' + name + '</h3>');
    bits.push('<div class="match-tags">');
    var archCls = matched.archetype ? " is-matched" : "";
    bits.push('<span class="match-arch' + archCls + '" data-arch="' + I.escAttr(lp.archetype) + '">'
      + I.esc(ARCH_LABELS[lp.archetype] || lp.archetype) + '</span>');
    if (lp.country) bits.push('<span class="match-country">' + I.esc(I.countryName(META, lp.country)) + '</span>');
    bits.push('</div>');
    bits.push('</div>');

    if (lp.hasThesis) {
      if (lp.themes && lp.themes.length) {
        var themeSpan = lp.themes.map(function (t) {
          var on = matchedThemes.has(t) ? " is-matched" : "";
          return '<span class="match-chip match-chip-theme' + on + '">' + I.esc(THEME_LABELS[t] || t) + '</span>';
        }).join("");
        bits.push('<div class="match-row"><span class="match-row-label">Themes</span> ' + themeSpan + '</div>');
      }
      if (lp.geos && lp.geos.length) {
        var geoSpan = lp.geos.map(function (g) {
          var on = matchedGeos.has(g) ? " is-matched" : "";
          return '<span class="match-chip match-chip-geo' + on + '">' + I.esc(GEO_LABELS[g] || g) + '</span>';
        }).join("");
        bits.push('<div class="match-row"><span class="match-row-label">Geo</span> ' + geoSpan + '</div>');
      }
    } else if (anySelected) {
      bits.push('<div class="match-noflag">Thesis not on file — ranked on archetype fit only</div>');
    }

    if (lp.thesis_excerpt) {
      bits.push('<blockquote class="match-excerpt">' + I.esc(lp.thesis_excerpt) + '</blockquote>');
    }

    bits.push('<div class="match-foot">');
    bits.push('<span class="match-edge-count">' + lp.networkLpCount + ' tracked LP commit'
      + (lp.networkLpCount === 1 ? '' : 's') + '</span>');
    if (lp.thesis_url) {
      bits.push('<a class="match-foot-link" href="' + I.escAttr(lp.thesis_url) + '" target="_blank" rel="noopener">stated thesis ↗</a>');
    }
    bits.push('</div>');

    // ProPublica 990 sizing — only when we have it (US foundations only).
    // Honest-null: omit silently when fields missing. When the foundation has
    // a sister trust (e.g. Kellogg, BMGF), append a "+ Trust ↗" link so the
    // user can drill into the trust filing — totalAssetsUSD already reflects
    // any per-trust consolidation method (add / note) configured upstream.
    var sig = LP_990[lp.slug];
    if (sig) {
      // Two-line layout. Line 1: the numbers (takeaway). Line 2: the
      // provenance, spelled out so "FY2023" is unambiguously the filing year.
      var assets = fmtUSDShort(sig.totalAssetsUSD);
      var grants = fmtUSDShort(sig.annualGrantsPaidUSD);
      var year = sig.latestFilingYear;
      var numbersParts = [];
      if (assets) numbersParts.push(assets + ' assets');
      if (grants) numbersParts.push(grants + ' grants paid');
      if (numbersParts.length) {
        var numbersLine = I.esc(numbersParts.join(' · '));

        var sourceText = year
          ? 'Most recent IRS 990 filed for FY' + year
          : 'Latest IRS 990 filing';
        var sourceLink = sig.sourceUrl
          ? '<a href="' + I.escAttr(sig.sourceUrl) + '" target="_blank" rel="noopener">' + I.esc(sourceText) + ' ↗</a>'
          : I.esc(sourceText);

        var trustTag = '';
        if (sig.sisterTrustName && sig.sisterTrustSourceUrl) {
          trustTag = ' · <a class="match-990-trust" href="' + I.escAttr(sig.sisterTrustSourceUrl) + '" target="_blank" rel="noopener" title="' + I.escAttr(sig.sisterTrustName) + ' — corpus-holding trust (separate IRS filing)">+ Trust ↗</a>';
        }

        bits.push(
          '<div class="match-990">'
          + '<div class="match-990-numbers">' + numbersLine + '</div>'
          + '<div class="match-990-source">' + sourceLink + trustTag + ' <span class="match-990-src">via ProPublica</span></div>'
          + '</div>'
        );
      }
    }

    var intros = introducersFor(lp.slug);
    bits.push('<div class="match-intros">');
    bits.push('<div class="match-intros-head">Who can introduce you to <strong>' + I.esc(lp.name) + '</strong>?</div>');
    if (intros.length === 0) {
      bits.push('<div class="match-intros-empty">No documented co-investors in our data — cold outreach.</div>');
    } else {
      var listCls = "connective-colps match-intros-list" + (intros.length > 3 ? " is-collapsed" : "");
      bits.push('<ul class="' + listCls + '" data-total="' + intros.length + '">');
      intros.forEach(function (c) {
        var fundLink = c.source_url
          ? '<a href="' + I.escAttr(c.source_url) + '" target="_blank" rel="noopener">' + I.esc(c.via_fund_name) + ' <span class="connective-source-arrow">↗</span></a>'
          : I.esc(c.via_fund_name);
        bits.push('<li class="connective-colp">'
          + '<span class="connective-colp-name">' + I.esc(c.name) + '</span>'
          + '<span class="connective-colp-arch" data-arch="' + I.escAttr(c.archetype) + '">' + I.esc(ARCH_LABELS[c.archetype] || c.archetype) + '</span>'
          + '<span class="connective-colp-via">via ' + fundLink + '</span>'
          + '</li>');
      });
      bits.push('</ul>');
      if (intros.length > 3) {
        bits.push('<button type="button" class="match-intros-show-more">show ' + (intros.length - 3) + ' more…</button>');
      }
    }
    bits.push('</div>');

    var clickCls = lp.thesis_url ? " card-clickable" : "";
    var dataAttr = lp.thesis_url ? ' data-source-url="' + I.escAttr(lp.thesis_url) + '"' : "";
    return '<article class="match-card' + clickCls + '"' + dataAttr + '>' + bits.join("") + '</article>';
  }

  function detailUrl(lp) {
    var prefix = (window.IFC_PATH_PREFIX || "/");
    var arch = lp.archetype;
    if (arch === "dfi") return prefix + "dfis/#dfi-" + lp.slug;
    if (arch === "foundation") return prefix + "foundations/#fdn-" + lp.slug;
    if (arch === "family-office") return prefix + "family-offices/#famof-" + lp.slug;
    if (arch === "asset-manager") return prefix + "asset-managers/#am-" + lp.slug;
    if (arch === "bank") return prefix + "banks/#bank-" + lp.slug;
    if (arch === "pension-fund") return prefix + "pension-funds/#pf-" + lp.slug;
    if (arch === "corporate") return prefix + "corporates/#corp-" + lp.slug;
    if (arch === "bilateral-donor") return prefix + "government-donors/#govd-" + lp.slug;
    if (arch === "government") return prefix + "government-donors/#govd-" + lp.slug;
    if (arch === "cooperative-ngo") return prefix + "cooperative-ngos/#coop-" + lp.slug;
    return null;
  }

  // Delegated handler for the per-card "show N more… / show less" introducer
  // toggle. Cards are rebuilt on every render(), so a single delegated
  // listener is simpler than re-attaching per render. stopPropagation
  // prevents the card-click (which opens the LP's stated-thesis URL) from
  // firing.
  document.getElementById("match-list").addEventListener("click", function (e) {
    var btn = e.target.closest(".match-intros-show-more");
    if (!btn) return;
    e.stopPropagation();
    var card = btn.closest(".match-card");
    if (!card) return;
    var list = card.querySelector(".match-intros-list");
    if (!list) return;
    var collapsed = list.classList.toggle("is-collapsed");
    btn.classList.toggle("is-expanded", !collapsed);
    var total = parseInt(list.getAttribute("data-total"), 10) || 0;
    btn.firstChild.nodeValue = collapsed ? "show " + (total - 3) + " more…" : "show less ";
  });

  I.installCardClick(".detail-page");
  render();
})();
</script>
